# .geminiignore
# Verhindert, dass Antigravity unnötige Token bei Scans verbrennt

# 1. Lokale Python-Umgebungen & Caches
.venv/
venv/
env/
__pycache__/
*.pyc
*.pyo
.pytest_cache/

# 2. Daten, Backups und Archive (Extrem wichtig für dich!)
# Schließt deine Archivordner aus, damit die KI nicht Gigabytes an PDFs scannt
archive/
backup/
backups/
bilder/
Bilder/
dist_*/
v*/
*.csv
*.xlsx
*.sql
*.zip
*.tar.gz
befehle.txt
license.key
start_venv.bat

# 3. Web- & Dependency-Ordner (Falls du Gambio/Shopware-Projekte spiegelst)
node_modules/
vendor/
.git/

# 4. IDE-eigene Daten
.antigravity/
.idea/
.vscode/
